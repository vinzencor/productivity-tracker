rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /employees/{empId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /workTypes/{typeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
